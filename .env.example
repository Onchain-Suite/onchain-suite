# Copy to .env and fill in. Never commit the filled-in file.

# --- Backend (separate Render service) ---
BACKEND_URL=
BACKEND_API_KEY=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PayloadCMS (blog) ---
# A database the CMS owns OUTRIGHT. Do NOT point this at the product database or
# at the Render backend's database: Payload's migrations manage this schema
# exclusively, so `payload migrate` (and especially migrate:fresh/reset) must
# never be able to touch tables it does not own.
#
# Use the POOLED connection string -- the host containing "-pooler". Serverless
# functions open a connection per invocation and would exhaust a direct
# connection limit.
#
# An empty database is all that is required; migrations create everything.
DATABASE_URI=postgresql://user:password@host-pooler.region.aws.neon.tech/onchain_blog?sslmode=require

# Signs admin sessions. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Guards the draft-preview route so unpublished posts are not publicly readable.
# Generate with: openssl rand -hex 16
PAYLOAD_PREVIEW_SECRET=

# Absolute site origin. Used for canonical URLs, sitemap entries, the SEO
# plugin's URL preview, and to build live-preview links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Cloudinary (blog media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---
ARCJET_KEY=
