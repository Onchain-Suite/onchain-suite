# Local development environment for the Onchain Suite frontend.
# Copy to .env and adjust. The backend runs separately - see the onchain-backend
# repo (docker compose up --build), which serves the API on :8080.

# Backend API base. The local backend (onchain-backend docker-compose) is on 8080.
# The browser never hits this directly; this app's /api/v1 proxy forwards to it.
BACKEND_URL=http://localhost:8080/api/v1
# Exposed to the browser so branding asset URLs (org logos) resolve against the
# backend origin. Keep it in sync with BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# Optional server key the proxy forwards to the backend as a bearer. Leave empty
# for a local backend (it authenticates via cookies / JWT, not this key).
BACKEND_API_KEY=

# Public URL of THIS app. Must match the URL you open in the browser (use
# localhost, not 127.0.0.1, and keep it consistent).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payload CMS database (/admin only) - a Postgres connection string. Not needed
# to run or log into the app. In production this is a Coolify-managed Postgres on
# a DigitalOcean droplet.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/onchain_cms

# Payload secret - any random string locally.
PAYLOAD_SECRET=dev-only-secret-change-me
