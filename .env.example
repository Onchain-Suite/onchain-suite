# Local development environment for the Onchain Suite frontend.
# Copy to .env and adjust. The backend runs separately - see the onchain-backend
# repo (docker compose up --build), which serves the API on :8080.

# Backend API base. The local backend (onchain-backend docker-compose) is on 8080.
# The browser never hits this directly; this app's /api/v1 proxy forwards to it.
BACKEND_URL=http://localhost:8080/api/v1
# Exposed to the browser so branding asset URLs (org logos) resolve against the
# backend origin. Keep it in sync with BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# Optional server key the proxy forwards to the backend as a bearer. Leave empty
# for a local backend (it authenticates via cookies / JWT, not this key).
BACKEND_API_KEY=

# --- Cal.com -> OnchainSuite booking relay (/api/integrations/calcom/webhook) ---
# Server-only. The relay verifies Cal's signature, maps the booking, and POSTs it
# to the Custom Events ingest (POST /api/v1/events), which creates/updates the
# contact, adds it to the list, and fires the list-joined automation. No capture
# form is involved. The first two are required for the relay to run.
# Shared secret used to sign the Cal.com webhook (HMAC-SHA256 over the raw body).
CALCOM_WEBHOOK_SECRET=
# OnchainSuite secret key (sk_live_... / sk_test_...). Resolves the org + write
# scope for the events ingest. Use sk_test_ to dry-run.
CALCOM_INGEST_API_KEY=
# Optional: list name/id to add bookers to (default "Booked a Demo/Walkthrough").
CALCOM_TARGET_LIST=
# Optional: the custom event name recorded (default "cal_demo_booked").
CALCOM_EVENT_NAME=

# Public URL of THIS app. Must match the URL you open in the browser (use
# localhost, not 127.0.0.1, and keep it consistent).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payload CMS database (/admin only) - a Postgres connection string. Not needed
# to run or log into the app. In production this is a Coolify-managed Postgres on
# a DigitalOcean droplet.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/onchain_cms

# Payload secret - any random string locally.
PAYLOAD_SECRET=dev-only-secret-change-me

# PostHog product analytics. Required: the instrumentation throws in development
# when these are unset (so a teammate without them can't run `bun dev`). Get them
# from your PostHog project settings; host is https://us.i.posthog.com or
# https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
