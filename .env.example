# Copy to .env and fill in. Never commit the filled-in file.

# --- Backend (separate Render service) ---
BACKEND_URL=
BACKEND_API_KEY=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PayloadCMS (blog) ---
# Neon Postgres. Use the POOLED connection string (the host containing
# "-pooler") -- serverless functions open a connection per invocation and would
# exhaust a direct connection limit.
DATABASE_URI=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Signs admin sessions. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Guards the draft-preview route so unpublished posts are not publicly readable.
# Generate with: openssl rand -hex 16
PAYLOAD_PREVIEW_SECRET=

# Absolute site origin. Used for canonical URLs, sitemap entries, the SEO
# plugin's URL preview, and to build live-preview links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Cloudinary (blog media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---
ARCJET_KEY=
